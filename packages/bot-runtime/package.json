{
  "name": "@delyforge/bot-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "The process each DelyForge bot runs in (discord.js). Data-driven: runs validated configuration, never user code.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./process": {
      "default": "./dist/process.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@delyforge/shared": "workspace:*",
    "discord.js": "^14.28.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
