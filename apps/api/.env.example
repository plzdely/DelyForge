# Copy this file to `.env` (same folder) for local development. NEVER commit `.env`.

NODE_ENV=development
PORT=4000

# Local development database started by `pnpm db:up` (Prisma's built-in Postgres — no Docker needed).
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# The local prisma dev database handles one connection at a time.
DATABASE_POOL_MAX=1
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Using Docker instead (`pnpm db:up:docker`)? Use this line and remove SHADOW_DATABASE_URL:
# DATABASE_URL="postgresql://delyforge:delyforge_dev_only@localhost:5433/delyforge?schema=public"

# Comma-separated list of origins allowed to call the API from a browser (future web dashboard).
CORS_ORIGINS=http://localhost:5173

# Stripe (Phase 7) — leave empty until you create a Stripe account.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Access-token signing secret (32+ random characters). Generate real values with:
#   pnpm --filter @delyforge/api keys:generate
JWT_SECRET=dev-only-change-me-0123456789abcdefghijklmnop

# Ed25519 key that signs plan certificates (base64 PEM). Leave empty in development for a temporary key.
ENTITLEMENT_PRIVATE_KEY=

PUBLIC_API_URL=http://localhost:4000

# AI features (console.anthropic.com → API keys). Leave empty to keep AI switched off.
ANTHROPIC_API_KEY=

# Stripe price IDs per plan (create Products/Prices in the Stripe dashboard, then run pnpm db:seed).
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_BUSINESS_MONTH=
STRIPE_PRICE_BUSINESS_YEAR=
