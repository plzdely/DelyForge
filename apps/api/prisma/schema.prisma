// DelyForge Cloud database schema (PostgreSQL).
// See ARCHITECTURE.md §6. Every change must be shipped as a migration: `pnpm db:migrate`.
//
// Conventions:
//  - IDs are cuid2-style strings generated by Prisma (`cuid()`), safe to expose in URLs.
//  - Secrets (passwords, refresh tokens, email tokens) are stored HASHED only.
//  - Discord bot tokens are NEVER stored here in v1 — they stay on the customer's machine.
//  - Money is stored in integer cents.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  SUPPORT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  /// Argon2id hash. Never a plain-text password.
  passwordHash    String
  displayName     String
  avatarUrl       String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  stripeCustomerId String?   @unique
  /// Linked Discord account (required to use DelyForge when Discord linking is configured). Never a Discord token.
  discordId        String?   @unique
  discordUsername  String?
  discordAvatarUrl String?
  discordLinkedAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?

  sessions          Session[]
  emailTokens       EmailToken[]
  memberships       WorkspaceMember[]
  ownedWorkspaces   Workspace[]       @relation("WorkspaceOwner")
  aiUsage           AiUsage[]
  developerProfile  DeveloperProfile?
  purchases         Purchase[]
  reviews           Review[]
  favorites         Favorite[]
  notifications     Notification[]
  auditLogs         AuditLog[]        @relation("AuditActor")
  supportTickets    SupportTicket[]
  aiChangeProposals AiChangeProposal[]
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  /// SHA-256 of the refresh token. The raw token only exists on the client.
  refreshTokenHash String    @unique
  /// Rotation family — reuse of a rotated token revokes the whole family.
  familyId         String
  deviceName       String?
  userAgent        String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  /// Active workspace on this device (null = the personal workspace).
  workspaceId      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  CHANGE_EMAIL
  /// One-time `state` for the Discord sign-in round trip.
  DISCORD_LINK
}

model EmailToken {
  id         String            @id @default(cuid())
  userId     String
  purpose    EmailTokenPurpose
  /// SHA-256 of the token sent by email. Single use.
  tokenHash  String            @unique
  newEmail   String?
  /// DISCORD_LINK confirmation step: the Discord account waiting for the person to confirm.
  payload    Json?
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

// ─────────────────────────────────────────────────────────────────────────────
// Workspaces & teams
// ─────────────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  DEVELOPER
  VIEWER
}

/// Every user has a personal workspace; Business/Enterprise customers can have shared ones.
/// Subscriptions belong to workspaces, so a team shares one plan.
model Workspace {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  isPersonal Boolean  @default(false)
  ownerId    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner                User                  @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members              WorkspaceMember[]
  invites              WorkspaceInvite[]
  subscription         Subscription?
  entitlementOverrides EntitlementOverride[]
  cloudBots            CloudBotProject[]
  backups              ConfigBackup[]
  aiUsage              AiUsage[]
  auditLogs            AuditLog[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  joinedAt    DateTime      @default(now())

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  botGrants   BotAccessGrant[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model WorkspaceInvite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole
  tokenHash   String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

/// Fine-grained per-bot permissions on top of the workspace role.
model BotAccessGrant {
  id           String  @id @default(cuid())
  memberId     String
  botId        String
  canView      Boolean @default(true)
  canConfigure Boolean @default(false)
  canControl   Boolean @default(false) // start / stop / restart

  member WorkspaceMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  bot    CloudBotProject @relation(fields: [botId], references: [id], onDelete: Cascade)

  @@unique([memberId, botId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plans, billing & entitlements
// ─────────────────────────────────────────────────────────────────────────────

/// DB-driven plan catalogue (seeded from packages/shared/src/plans.ts, editable by admins).
model Plan {
  /// 'free' | 'pro' | 'business' | 'enterprise'
  id          String   @id
  name        String
  tagline     String
  rank        Int
  isPublic    Boolean  @default(true)
  /// PlanLimits JSON (see @delyforge/shared).
  limits      Json
  /// FeatureKey[] JSON.
  features    Json
  highlights  Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  prices        PlanPrice[]
  subscriptions Subscription[]
}

enum BillingInterval {
  MONTH
  YEAR
}

model PlanPrice {
  id            String          @id @default(cuid())
  planId        String
  interval      BillingInterval
  amountCents   Int
  currency      String          @default("usd")
  /// Stripe Price ID — set once products are created in Stripe.
  stripePriceId String?         @unique
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())

  plan Plan @relation(fields: [planId], references: [id])

  @@unique([planId, interval, currency, active])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  PAUSED
}

/// Mirror of the Stripe subscription. Stripe is the source of truth; webhooks keep this in sync.
model Subscription {
  id                   String             @id @default(cuid())
  workspaceId          String             @unique
  planId               String
  status               SubscriptionStatus
  interval             BillingInterval
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  canceledAt           DateTime?
  trialEndsAt          DateTime?
  /// `created` time of the last Stripe event applied, so out-of-order deliveries are ignored.
  lastEventAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  plan      Plan      @relation(fields: [planId], references: [id])
}

/// Idempotent log of Stripe webhook events (each event processed exactly once).
model BillingEvent {
  id            String    @id @default(cuid())
  stripeEventId String    @unique
  type          String
  payload       Json
  processedAt   DateTime?
  error         String?
  receivedAt    DateTime  @default(now())

  @@index([type])
}

/// Admin-granted entitlements (Enterprise deals, beta access, support credits).
model EntitlementOverride {
  id            String    @id @default(cuid())
  workspaceId   String
  /// FeatureKey[] JSON
  grantFeatures Json      @default("[]")
  /// Partial<PlanLimits> JSON
  limits        Json      @default("{}")
  reason        String
  grantedById   String
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Cloud bot metadata (sync, backups, future hosting) — NO Discord tokens
// ─────────────────────────────────────────────────────────────────────────────

enum BotHostingMode {
  LOCAL
  CLOUD
}

model CloudBotProject {
  id                   String         @id @default(cuid())
  workspaceId          String
  /// ID of the project in the desktop app's local database.
  localId              String
  name                 String
  discordApplicationId String?
  hostingMode          BotHostingMode @default(LOCAL)
  /// Validated config snapshot (modules, commands, workflows). Tokens excluded.
  configSnapshot       Json?
  configVersion        Int            @default(0)
  lastSeenOnlineAt     DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  grants    BotAccessGrant[]

  @@unique([workspaceId, localId])
}

model ConfigBackup {
  id           String   @id @default(cuid())
  workspaceId  String
  botLocalId   String?
  label        String
  /// AES-256-GCM encrypted backup blob (base64). Encrypted client-side.
  encryptedBlob String
  sizeBytes    Int
  checksum     String
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI
// ─────────────────────────────────────────────────────────────────────────────

model AiProvider {
  /// e.g. 'anthropic', 'openai'
  id        String    @id
  name      String
  enabled   Boolean   @default(true)
  createdAt DateTime  @default(now())

  models AiModel[]
}

model AiModel {
  id                     String   @id @default(cuid())
  providerId             String
  /// Provider's model identifier.
  modelKey               String
  displayName            String
  inputCostPerMTokCents  Int
  outputCostPerMTokCents Int
  /// Which DelyForge features may use this model, e.g. ["builder","troubleshooting"].
  features               Json     @default("[]")
  enabled                Boolean  @default(true)
  isDefault              Boolean  @default(false)
  createdAt              DateTime @default(now())

  provider AiProvider @relation(fields: [providerId], references: [id])
  usage    AiUsage[]

  @@unique([providerId, modelKey])
}

model AiUsage {
  id           String   @id @default(cuid())
  workspaceId  String
  userId       String
  modelId      String
  feature      String
  inputTokens  Int
  outputTokens Int
  credits      Int
  /// Our cost in hundredths of a cent, for business reporting.
  costMicroCents Int
  success      Boolean
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  model     AiModel   @relation(fields: [modelId], references: [id])

  @@index([workspaceId, createdAt])
}

enum ProposalStatus {
  PENDING
  APPLIED
  REJECTED
  EXPIRED
}

/// AI output is never applied silently: it becomes a proposal the user reviews and approves.
model AiChangeProposal {
  id          String         @id @default(cuid())
  userId      String
  botLocalId  String?
  prompt      String
  summary     String
  /// Validated change set (modules / commands / workflows).
  changeSet   Json
  status      ProposalStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  decidedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketplace
// ─────────────────────────────────────────────────────────────────────────────

enum ListingType {
  TEMPLATE
  WORKFLOW_PACK
  EMBED_PACK
  COMMAND_PACK
  MODULE
  PLUGIN
  THEME
  INTEGRATION
}

enum ListingStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  REJECTED
  SUSPENDED
}

model DeveloperProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  displayName            String
  slug                   String   @unique
  bio                    String?
  website                String?
  /// Stripe Connect account for payouts.
  stripeConnectAccountId String?  @unique
  verifiedAt             DateTime?
  createdAt              DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  listings Listing[]
}

model Listing {
  id          String        @id @default(cuid())
  developerId String
  type        ListingType
  slug        String        @unique
  title       String
  summary     String
  description String
  category    String
  tags        String[]
  priceCents  Int           @default(0)
  status      ListingStatus @default(DRAFT)
  screenshots String[]
  ratingAvg   Float         @default(0)
  ratingCount Int           @default(0)
  downloads   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  developer DeveloperProfile @relation(fields: [developerId], references: [id])
  versions  ListingVersion[]
  purchases Purchase[]
  reviews   Review[]
  favorites Favorite[]

  @@index([type, status])
  @@index([category])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model ListingVersion {
  id               String       @id @default(cuid())
  listingId        String
  version          String
  changelog        String?
  /// Declared manifest: type, permissions, compatibility range.
  manifest         Json
  /// Minimum DelyForge version this works with (semver).
  minAppVersion    String
  /// Where a large package file is hosted (unused while packages are stored inline in `content`).
  packageUrl       String?
  /// The declarative package (validated by @delyforge/shared validatePackage).
  content          Json?
  packageSha256    String
  /// Ed25519 signature by DelyForge after review. Desktop refuses unsigned packages.
  signature        String?
  reviewStatus     ReviewStatus @default(PENDING)
  reviewNotes      String?
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime     @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, version])
}

model Purchase {
  id                    String   @id @default(cuid())
  userId                String
  listingId             String
  amountCents           Int
  platformFeeCents      Int
  stripePaymentIntentId String?  @unique
  refundedAt            DateTime?
  createdAt             DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  listing Listing @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  rating    Int
  body      String?
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
}

model Favorite {
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Operations
// ─────────────────────────────────────────────────────────────────────────────

enum BanKind {
  EMAIL
  DISCORD
}

/// Identities that may never be used for DelyForge again (set when staff ban an account).
model Ban {
  id         String   @id @default(cuid())
  kind       BanKind
  /// Lower-case email address or Discord user ID.
  value      String
  reason     String
  bannedById String
  /// The account that was banned (kept for reference; the identity stays banned even if it is deleted).
  userId     String?
  createdAt  DateTime @default(now())

  @@unique([kind, value])
}

/// Append-only audit trail. Admin and privileged team actions MUST write here.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  workspaceId String?
  action      String
  targetType  String?
  targetId    String?
  ipAddress   String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  actor     User?      @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([actorId, createdAt])
  @@index([action])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  level       String    @default("info")
  publishedAt DateTime?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  body      String
  status    TicketStatus @default(OPEN)
  priority  String       @default("normal")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Crash/error reports from desktop clients (opt-in, redacted before upload).
model ErrorReport {
  id          String   @id @default(cuid())
  appVersion  String
  platform    String
  message     String
  stack       String?
  fingerprint String
  count       Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([fingerprint, appVersion])
}
